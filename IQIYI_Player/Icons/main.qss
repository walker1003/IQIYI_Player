/* 1. 窗口总底色（设为黑色） */
QMainWindow, QWidget#centralwidget {
    background-color: #000000;
    font-family: "Microsoft YaHei", sans-serif;
}

/* 2. 标题栏左上角 Logo */
#btnLogo {
    background: transparent;
    border: none;
    color: #00be64;
    font-size: 13px;
    font-weight: bold;
    padding-left: 8px;
}
#btnLogo:hover {
    color: #00e077;
}

/* 3. 顶部系统按钮（最小化、最大化、关闭等） */
QWidget#widgetTitleBar {
    background-color: #060e0a; /* 接近纯黑的极深色，也可以直接写 #000000 */
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
#widgetTitleBar QPushButton {
    background: transparent;
    border: none;
    min-width: 38px;
    min-height: 32px;
}
#widgetTitleBar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
}
#btnClose:hover {
    background-color: #e81123 !important; /* 关闭按钮悬浮变红 */
}

/* 欢迎文案：纯白高亮 */
/* 3. 中间欢迎区单独保持墨绿色（与你的插画融合） */
QWidget#pageWelcome, QStackedWidget#stackedWidget {
    background-color: #13271f;
}
#lblTitle {
    color: #ffffff !important;
    font-size: 24px !important;
    font-weight: bold !important;
}

/* 1. 外层容器：负责整个绿色胶囊的背景、圆角和阴影，浑然一体 */
QWidget#widgetOpenGroup {
    background-color: #00be64;
    border-radius: 18px;
    min-height: 36px;
    max-height: 36px;
}
/* 鼠标滑过整个胶囊微亮 */
QWidget#widgetOpenGroup:hover {
    background-color: #00d671;
}

/* 2. 左边按钮：透明背景，纯文字 */
QPushButton#btnOpen {
    background-color: transparent;
    color: #ffffff !important;
    font-size: 14px;
    font-weight: bold;
    border: none;
    padding-left: 18px;
    padding-right: 12px;
}

/* 3. 右边小三角：透明背景，左侧带一条原版的微弱细分割线 */
QPushButton#btnOpenMore {
    background-color: transparent;
    border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.25); /* 原版标志性的细分割线 */
    min-width: 28px;
    max-width: 28px;
}

/* 右侧贴边抽屉收缩按钮 */
#btnDrawer {
    background-color: #081510; /* 更深沉的底色 */
    border: none;
    border-top-left-radius: 8px;     /* 更圆润的半弧 */
    border-bottom-left-radius: 8px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    min-width: 18px;                 /* 宽度加宽 */
    max-width: 18px;
    min-height: 60px;                /* 高度明显拉长 */
    max-height: 60px;
    padding-right: 2px;
}
#btnDrawer:hover {
    background-color: #122c22;
}

/* 7. 底部控制栏所有按钮（去边框、透明、悬停微亮） */
QWidget#widgetBottomBar {
    background-color: #060e0a; /* 接近纯黑的极深色，也可以直接写 #000000 */
    border-top: 1px solid rgba(255, 255, 255, 0.04); /* 可选：上方极细弱的分界线 */
}
#widgetBottomBar QPushButton {
    background: transparent;
    border: none;
    min-width: 32px;
    min-height: 32px;
    opacity: 0.8;
}
#widgetBottomBar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
}

/* 8. 底部中间大播放键稍微加大 */
#btnPlay {
    min-width: 42px;
    min-height: 42px;
}