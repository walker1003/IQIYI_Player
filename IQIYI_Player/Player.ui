  <property name="styleSheet">
   <string notr="true">/* 1. 窗口总底色（设为黑色） */
QMainWindow, QWidget#centralwidget {
    background-color: #000000;
    font-family: &quot;Microsoft YaHei&quot;, sans-serif;
}

/* 2. 标题栏左上角 Logo */
#btnLogo {
    background: transparent;
    border: none;
    color: #00be64;
    font-size: 13px;
    font-weight: bold;
    padding-left: 8px;
}
#btnLogo:hover {
    color: #00e077;
}

/* 3. 顶部系统按钮（最小化、最大化、关闭等） */
QWidget#widgetTitleBar {
    background-color: #060e0a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
#widgetTitleBar QPushButton {
    background: transparent;
    border: none;
    min-width: 38px;
    min-height: 32px;
}
#widgetTitleBar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
}
#btnClose:hover {
    background-color: #e81123 !important;
}

/* 欢迎文案：纯白高亮 */
QWidget#pageWelcome, QStackedWidget#stackedWidget {
    background-color: #13271f;
}
#lblTitle {
    color: #ffffff !important;
    font-size: 24px !important;
    font-weight: bold !important;
}

/* 1. 外层容器：负责整个绿色胶囊的背景、圆角和阴影 */
QWidget#widgetOpenGroup {
    background-color: #00be64;
    border-radius: 18px;
    min-height: 36px;
    max-height: 36px;
}
QWidget#widgetOpenGroup:hover {
    background-color: #00d671;
}

/* 2. 左边按钮：透明背景，纯文字 */
QPushButton#btnOpen {
    background-color: transparent;
    color: #ffffff !important;
    font-size: 14px;
    font-weight: bold;
    border: none;
    padding-left: 18px;
    padding-right: 12px;
}

/* 3. 右边小三角 */
QPushButton#btnOpenMore {
    background-color: transparent;
    border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.25);
    min-width: 28px;
    max-width: 28px;
}

/* 右侧贴边抽屉收缩按钮 */
#btnDrawer {
    background-color: #081510;
    border: none;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    min-width: 18px;
    max-width: 18px;
    min-height: 60px;
    max-height: 60px;
    padding-right: 2px;
}
#btnDrawer:hover {
    background-color: #122c22;
}

/* 底部控制栏 */
QWidget#widgetBottomBar {
    background-color: #060e0a;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
}
#widgetBottomBar QPushButton {
    background: transparent;
    border: none;
    min-width: 32px;
    min-height: 32px;
    opacity: 0.8;
}
#widgetBottomBar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
}

#btnPlay {
    min-width: 42px;
    min-height: 42px;
}

/* 右侧面板整体背景 */
QWidget#widgetPlaylist {
    background-color: #0e1511;
    border-left: 1px solid rgba(255, 255, 255, 0.05);
}

QWidget#widgetPlaylistHeader {
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

#lblPlaylistTitle {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
}

#lblPlaylistCount {
    color: #5d7066;
    font-size: 11px;
    padding-left: 4px;
}

#widgetPlaylistHeader QPushButton {
    background: transparent;
    border: none;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
}
#widgetPlaylistHeader QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
}

#lblEmptyTip {
    color: #55665d;
    font-size: 12px;
    margin-top: 10px;
    margin-bottom: 14px;
}

QWidget#widgetAddGroup {
    background-color: #00be64;
    border-radius: 17px;
    min-height: 34px;
    max-height: 34px;
}
QWidget#widgetAddGroup:hover {
    background-color: #00d671;
}

QPushButton#btnAddFile {
    background-color: transparent;
    color: #ffffff !important;
    font-size: 13px;
    font-weight: bold;
    border: none;
    padding-left: 14px;
    padding-right: 6px;
}

QPushButton#btnAddMore {
    background-color: transparent;
    border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.25);
    min-width: 26px;
    max-width: 26px;
}</string>
